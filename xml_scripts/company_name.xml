<ENVELOPE>
    <HEADER>
        <VERSION>1</VERSION>
        <TALLYREQUEST>Export</TALLYREQUEST>
        <TYPE>COLLECTION</TYPE>
        <ID>ActiveCompanyCollection</ID>
    </HEADER>
    <BODY>
        <DESC>
            <STATICVARIABLES>
                <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
            </STATICVARIABLES>
            <TDL>
                <TDLMESSAGE>
                    <COLLECTION NAME="ActiveCompanyCollection">
                        <TYPE>Company</TYPE>
                        <FETCH>Name</FETCH>
                        <!-- Filter collection where company name matches active session variable -->
                        <FILTER>ActiveFilter</FILTER>
                    </COLLECTION>
                    <SYSTEM TYPE="Formulae" NAME="ActiveFilter">$$Name = ##SVCURRENTCOMPANY</SYSTEM>
                </TDLMESSAGE>
            </TDL>
        </DESC>
    </BODY>
</ENVELOPE>
